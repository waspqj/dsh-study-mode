  "repository": {
    "type": "git",
    "url": "https://github.com/waspqj/dsh-study-mode.git"
  },
  "type": "module",
  "main": "./plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./tools": "./plugin/tools.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "plugin/",
    "client/",
    "test/",
    "scripts/",
    "locale/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/format.test.mjs && node test/kb.test.mjs && node test/plugin.test.mjs && node test/card.test.mjs && node test/tools-schema.test.mjs && node test/ui.test.mjs && node test/client.test.mjs && node test/rerank.test.mjs && node test/llm.test.mjs && node test/compat.test.mjs && node test/links.test.mjs && node test/relate.test.mjs && node test/groups.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test",
    "verify:ui": "node .tools/verify-harness.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
